      "url": "/?tab=explore",
      "icons": [{ "src": "/pwa-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Historial",
      "short_name": "Historial",
      "description": "Audios escuchados recientemente",
      "url": "/?tab=history",
      "icons": [{ "src": "/pwa-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Favoritos",
