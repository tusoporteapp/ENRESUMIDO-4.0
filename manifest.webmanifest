{
  "name": "EnResumido - Audio Resúmenes",
  "short_name": "EnResumido",
  "description": "Audio resúmenes de libros y artículos para mentes ocupadas.",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#09090b",
  "theme_color": "#09090b",
